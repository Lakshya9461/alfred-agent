# Telegram Bot Token (obtained from BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram User IDs allowed to interact with the bot
TELEGRAM_ALLOWED_USER_IDS=

# URL for the Ollama API (e.g., http://localhost:11434)
OLLAMA_API_URL=

# The Ollama model to use
OLLAMA_MODEL=

# Max tool iterations per turn
MAX_TOOL_ITERATIONS=10

# How many turns before triggering a self-review
SELF_REVIEW_EVERY_N_TURNS=5

# Tavily API key for web search (optional, falls back to ddgs if not set)
TAVILY_API_KEY=

# Working directory for shell execution
SHELL_WORKING_DIR=

# Timeout in seconds for shell commands
SHELL_TIMEOUT_SECONDS=30

# Max number of lessons to remember
MAX_LESSONS=50

# Seconds between checks for newly installed Ollama models
MODEL_CHECK_INTERVAL=60

# Seconds between git update checks
GIT_UPDATE_CHECK_INTERVAL=300

# Automatically git pull when the remote is ahead (true) or only notify (false)
AUTO_PULL=true
