# Telegram Bot Token (obtained from BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram User IDs allowed to interact with the bot
TELEGRAM_ALLOWED_USER_IDS=

# URL for the Ollama API (e.g., http://localhost:11434)
OLLAMA_API_URL=

# The Ollama model to use
OLLAMA_MODEL=

# Max tool iterations per turn
MAX_TOOL_ITERATIONS=30

# How many turns before triggering a self-review
SELF_REVIEW_EVERY_N_TURNS=5

# Tavily API key for web search (optional, falls back to ddgs if not set)
TAVILY_API_KEY=

# Working directory for shell execution
SHELL_WORKING_DIR=

# Timeout in seconds for shell commands
SHELL_TIMEOUT_SECONDS=30

# Max number of lessons to remember
MAX_LESSONS=50

# Seconds between checks for newly installed Ollama models
MODEL_CHECK_INTERVAL=60

# Seconds between git update checks
GIT_UPDATE_CHECK_INTERVAL=300

# Seconds between checks for due cron reminders
CRON_CHECK_INTERVAL=20

# Automatically git pull when the remote is ahead (true) or only notify (false)
AUTO_PULL=true

# Seconds to wait for a user to confirm a dangerous command before auto-cancelling
CONFIRMATION_TIMEOUT_SECONDS=120

# Command used to restart the bot. Under the pywin32 service this is NOT needed —
# monitor.restart_bot() detects service mode (ALFRED_SERVICE_NAME) and runs
# `python service.py restart` automatically. Only set this to override that,
# e.g. if you use a custom supervisor command.
RESTART_COMMAND=

# Max size of append-only logs (conversations.jsonl / audit_log.jsonl) before rotation
LOG_MAX_BYTES=10485760

# Max number of lessons fed into the system prompt (relevance-scored)
MAX_LESSONS_IN_PROMPT=20

# Trial mode: require confirmation for EVERY shell command (true) or only dangerous ones (false)
CONFIRM_ALL_COMMANDS=false

# Per-request timeout (seconds) for Ollama API calls. The first request after
# startup cold-loads the model, which can be slow for big models/high context.
OLLAMA_REQUEST_TIMEOUT=300

# Hard cap on the context window sent to Ollama (num_ctx). 0 = auto-detect.
# Set this on machines that can't allocate the full KV cache of a huge-context
# model (e.g. ornith:9b auto-detects 262144). Try 32768 if /api/chat hangs.
OLLAMA_CONTEXT_LENGTH=0

# Comma-separated git URLs of skill repos to install + keep updated
SKILL_REPOS=https://github.com/addyosmani/agent-skills.git,https://github.com/mattpocock/skills.git

# Seconds between background skill-repo refresh + GitHub discovery
SKILL_UPDATE_INTERVAL=21600

# Seconds between autonomous self-improvement research passes (0 = disabled)
SELF_IMPROVE_INTERVAL=1800

# Hard cap on autonomous code applies per day (safety valve)
SELF_IMPROVE_MAX_PER_DAY=3

# Max files a single autonomous apply may touch
SELF_IMPROVE_MAX_FILES=2

# Second Ollama model used as a critic for second opinions (empty = reuse active model)
CRITIC_MODEL=

# Journal file for self-improvement notes (committed to git)
PROGRESS_AGENT_FILE=progress_agent.md

# Browser automation (browser-use/Playwright). Falls back to plain HTTP fetch if
# the packages or chromium are missing.
BROWSER_USE_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_USE_TIMEOUT=180

# External OpenAI-compatible LLM for the research loop (optional; empty = local Ollama only)
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_MODEL=
