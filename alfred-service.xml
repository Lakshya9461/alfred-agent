<service>
  <id>alfred-agent</id>
  <name>Alfred Agent Service</name>
  <description>Telegram bot agent powered by Ollama running as a limited user</description>
  
  <executable>%BASE%\venv\Scripts\python.exe</executable>
  <arguments>%BASE%\main.py</arguments>
  
  <log mode="roll">
    <logpath>%BASE%\logs</logpath>
  </log>
  
  <onfailure action="restart" delay="10 sec"/>
  
  <!-- Run as the dedicated limited service account -->
  <serviceaccount>
    <domain>.</domain>
    <user>alfredsvc</user>
    <password>YOUR_PASSWORD_HERE</password>
  </serviceaccount>
</service>
